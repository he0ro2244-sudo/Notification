<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <package android:name="com.google.android.keep" />
        <package android:name="com.samsung.android.app.notes" />
        <package android:name="com.microsoft.office.onenote" />
        <package android:name="com.evernote" />
        <package android:name="com.automattic.simplenote" />
        <package android:name="md.obsidian" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_tiles"
        android:label="Notif Tiles"
        android:theme="@style/NtTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Notif Tiles setup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PanelActivity"
            android:exported="true"
            android:label="Notif Tiles"
            android:theme="@style/NtPanelTheme"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DialActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/NtPanelTheme" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Look &amp; colors"
            android:theme="@style/NtTheme" />

        <activity
            android:name=".OpenClockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/NtPanelTheme" />

        <activity
            android:name=".OpenWeatherActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/NtPanelTheme" />

        <activity
            android:name=".DestinationActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/NtPanelTheme" />

        <receiver
            android:name=".TilesWidget"
            android:exported="true"
            android:label="Notif Tiles">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tiles_widget_info" />
        </receiver>

        <service
            android:name=".TilesService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".NotifListener"
            android:exported="true"
            android:label="Notif Tiles"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
