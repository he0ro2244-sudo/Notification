<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nt_widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wbgimg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

<LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/wlocA"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/nt_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wpinA"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pin" />

            <TextView
                android:id="@+id/wwA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Where to?"
                android:textColor="@color/nt_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <TextClock
            android:id="@+id/wclock0"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="visible"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textSize="14sp"
            />

        <TextView
            android:id="@+id/wweather0"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="gone"
            android:text="--°"
            android:textSize="13sp"
            />

        <TextClock
            android:id="@+id/wdate0"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="gone"
            android:format12Hour="EEE&#10;d MMM"
            android:format24Hour="EEE&#10;d MMM"
            android:textSize="12sp"
            />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <TextClock
            android:id="@+id/wclock1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="gone"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textSize="14sp"
            />

        <TextView
            android:id="@+id/wweather1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="visible"
            android:text="--°"
            android:textSize="13sp"
            />

        <TextClock
            android:id="@+id/wdate1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="gone"
            android:format12Hour="EEE&#10;d MMM"
            android:format24Hour="EEE&#10;d MMM"
            android:textSize="12sp"
            />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <TextClock
            android:id="@+id/wclock2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="gone"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textSize="14sp"
            />

        <TextView
            android:id="@+id/wweather2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="gone"
            android:text="--°"
            android:textSize="13sp"
            />

        <TextClock
            android:id="@+id/wdate2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:textColor="@color/nt_text"
           
            android:visibility="visible"
            android:format12Hour="EEE&#10;d MMM"
            android:format24Hour="EEE&#10;d MMM"
            android:textSize="12sp"
            />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/wlocB"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/nt_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/wpinB"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pin" />

            <TextView
                android:id="@+id/wwB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Where to?"
                android:textColor="@color/nt_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/dialwrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/nt_dial_bg"
        android:clipToOutline="true">

    <ImageView
        android:id="@+id/dialimg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dialrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/dial0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc0"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                />

            <TextView
                android:id="@+id/dn0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                />

            <TextView
                android:id="@+id/dn1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc2"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                />

            <TextView
                android:id="@+id/dn2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc3"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                />

            <TextView
                android:id="@+id/dn3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc4"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                />

            <TextView
                android:id="@+id/dn4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/hdr_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inbox"
            android:textColor="@color/nt_text"
            android:textSize="16sp"
            />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nt_badge_bg"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            />

        <ImageView
            android:id="@+id/wmic"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:contentDescription="Record"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:src="@drawable/ic_mic" />

        <TextView
            android:id="@+id/wnote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:text="+ Note"
            android:textColor="@color/nt_badge"
            android:textSize="13sp"
            />

        <TextView
            android:id="@+id/wclear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp"
            android:text="Clear all"
            android:textColor="@color/nt_sub"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/wset"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:contentDescription="Settings"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp"
            android:src="@drawable/ic_gear" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="6dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="2"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/empty_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nothing new from your apps"
                android:textColor="@color/nt_sub"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/wrefresh"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:contentDescription="Refresh"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:src="@drawable/ic_refresh" />

            <TextView
                android:id="@+id/wupdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nt_sub"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pagebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/wprev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="2dp"
            android:paddingEnd="22dp"
            android:paddingBottom="2dp"
            android:text="‹"
            android:textColor="@color/nt_badge"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/wpage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:textColor="@color/nt_badge"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wnext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="2dp"
            android:paddingEnd="22dp"
            android:paddingBottom="2dp"
            android:text="›"
            android:textColor="@color/nt_badge"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
