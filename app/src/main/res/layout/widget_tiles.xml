<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nt_widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wbgimg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

<LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">


    <LinearLayout
        android:id="@+id/blocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <FrameLayout
        android:id="@+id/gridwrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/tilelist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:visibility="gone" />

        <View
            android:id="@+id/nodata"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="6dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="2"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/empty_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nothing new from your apps"
                android:textColor="@color/nt_sub"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/wrefresh"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:contentDescription="Refresh"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:src="@drawable/ic_refresh" />

            <TextView
                android:id="@+id/wupdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nt_sub"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pagebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/wprev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="2dp"
            android:paddingEnd="22dp"
            android:paddingBottom="2dp"
            android:text="‹"
            android:textColor="@color/nt_badge"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/wpage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:textColor="@color/nt_badge"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wnext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="2dp"
            android:paddingEnd="22dp"
            android:paddingBottom="2dp"
            android:text="›"
            android:textColor="@color/nt_badge"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>

    <FrameLayout
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr" />

    <ImageView
        android:id="@+id/wborder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>
