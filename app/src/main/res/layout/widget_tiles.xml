<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nt_widget_bg"
    android:orientation="vertical"
    android:padding="8dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextClock
            android:id="@+id/wclock"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nt_circle_bg"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:textColor="@color/nt_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wweather"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nt_circle_bg"
            android:gravity="center"
            android:text="--°"
            android:textColor="@color/nt_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/wdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d MMM"
                android:format24Hour="EEE, d MMM"
                android:maxLines="1"
                android:textColor="@color/nt_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wloc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/wpin"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_pin" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:text="Amman, Jordan"
                    android:textColor="@color/nt_sub"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/dial0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc0"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dn0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dn1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc2"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dn2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc3"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dn3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dc4"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/nt_circle_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dn4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="Add"
                android:textColor="@color/nt_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/hdr_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inbox"
            android:textColor="@color/nt_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nt_badge_bg"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wnote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:text="+ Note"
            android:textColor="@color/nt_badge"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wclear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp"
            android:text="Clear all"
            android:textColor="@color/nt_sub"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="6dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="2"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Nothing new from your apps"
            android:textColor="@color/nt_sub"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
